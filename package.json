{
  "name": "iris-drive-web",
  "version": "0.1.2",
  "license": "MIT",
  "private": true,
  "description": "Iris Drive - content-addressed file sync on Nostr",
  "repository": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-drive-web",
  "homepage": "https://drive.iris.to/",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-drive-web?tab=issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "vite",
    "build:deps": "pnpm --dir ../iris-kit --filter ndk build && pnpm --dir ../iris-kit --filter ndk-cache build",
    "build": "pnpm run build:deps && vite build",
    "smoke:drive:iris": "node ./scripts/smoke-files-iris-portable.mjs",
    "smoke:files:iris": "node ./scripts/smoke-files-iris-portable.mjs",
    "test:drive:iris": "pnpm run build && pnpm run smoke:drive:iris",
    "test:files:iris": "pnpm run build && pnpm run smoke:files:iris",
    "publish:drive:iris": "node ./scripts/release-site.mjs drive --skip-cloudflare",
    "release:iris": "node ./scripts/release-site.mjs",
    "release:drive:iris": "node ./scripts/release-site.mjs drive",
    "release:files-redirect": "node ./scripts/deploy-files-redirect.mjs",
    "release:all:iris": "node ./scripts/release-site.mjs all",
    "build:analyze": "vite build && echo '\nBundle stats: dist/stats.html\nBundle list: dist/stats-list.txt'",
    "preview": "vite preview",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm run build:deps && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:drive-interop": "playwright test e2e/drive-interop.spec.ts",
    "test:e2e:drive-vm-interop": "PW_WORKERS=${PW_WORKERS:-1} playwright test e2e/drive-vm-interop.spec.ts --project=chromium",
    "test:e2e:docker": "bash ./scripts/test-e2e-docker.sh",
    "test:e2e:fast": "E2E_FAST=1 playwright test",
    "test:e2e:integration": "playwright test e2e/anchor-links.spec.ts e2e/compression.spec.ts e2e/explorer.test.ts e2e/link-visible-tree.spec.ts e2e/search-navigation.spec.ts e2e/viewer-actions.spec.ts",
    "test:e2e:slow": "playwright test e2e/livestream-viewer.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@fips/core": "github:mmalmi/fips-ts#602fed03486d2646c79abccf38550fc3ced9481d&path:/packages/core",
    "@fips/transport-webrtc": "github:mmalmi/fips-ts#602fed03486d2646c79abccf38550fc3ced9481d&path:/packages/transport-webrtc",
    "@hashtree/core": "link:../hashtree/ts/packages/hashtree",
    "@hashtree/dexie": "link:../hashtree/ts/packages/hashtree-dexie",
    "@hashtree/fips-transport": "link:../hashtree/ts/packages/hashtree-fips-transport",
    "@hashtree/index": "link:../hashtree/ts/packages/hashtree-index",
    "@hashtree/merge": "link:../hashtree/ts/packages/hashtree-merge",
    "@hashtree/nostr": "link:../hashtree/ts/packages/hashtree-nostr",
    "@hashtree/worker": "link:../hashtree/ts/packages/hashtree-worker",
    "@iris/hashtree-app": "file:../iris-kit/packages/hashtree-app",
    "@iris/identity": "link:../iris-kit/packages/identity",
    "@iris/release-tools": "file:../iris-kit/packages/release-tools",
    "@iris/svelte-ui": "file:../iris-kit/packages/svelte-ui",
    "@msgpack/msgpack": "^3.1.2",
    "@noble/hashes": "2.0.1",
    "@scure/base": "2.0.0",
    "@scure/bip39": "2.0.0",
    "@tiptap/core": "^2.26.2",
    "@tiptap/extension-collaboration": "^2.26.2",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-image": "^2.27.1",
    "@tiptap/extension-placeholder": "^2.26.2",
    "@tiptap/pm": "^2.26.2",
    "@tiptap/starter-kit": "^2.26.2",
    "coco-cashu-core": "1.1.2-rc.29",
    "coco-cashu-indexeddb": "1.1.2-rc.29",
    "dexie": "4.4.2",
    "dompurify": "^3.3.1",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "marked": "^15.0.0",
    "minidenticons": "^4.2.1",
    "ndk": "file:../iris-kit/packages/ndk",
    "ndk-cache": "file:../iris-kit/packages/ndk-cache",
    "nostr-social-graph": "link:../nostr-social-graph/ts",
    "nostr-tools": "2.23.3",
    "nostr-wasm": "^0.1.0",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.75",
    "@playwright/test": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/dompurify": "^3.2.0",
    "@types/prismjs": "^1.26.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@unocss/preset-icons": "^66.5.9",
    "@unocss/preset-typography": "^66.5.9",
    "debug": "4.4.3",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "happy-dom": "^15.11.7",
    "html2canvas": "^1.4.1",
    "open-props": "^1.7.16",
    "rollup-plugin-visualizer": "^6.0.5",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.4",
    "svelte-eslint-parser": "^1.4.1",
    "tseep": "1.3.1",
    "typescript": "^5.3.0",
    "typescript-lru-cache": "2.0.0",
    "unocss": "^66.5.9",
    "vite": "6.4.1",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "^4.0.17",
    "workbox-precaching": "^7.4.0",
    "workbox-window": "^7.4.0",
    "ws": "^8.18.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@fips/core": "github:mmalmi/fips-ts#602fed03486d2646c79abccf38550fc3ced9481d&path:/packages/core",
      "@fips/transport-webrtc": "github:mmalmi/fips-ts#602fed03486d2646c79abccf38550fc3ced9481d&path:/packages/transport-webrtc",
      "@hashtree/core": "link:../hashtree/ts/packages/hashtree",
      "@hashtree/fips-transport": "link:../hashtree/ts/packages/hashtree-fips-transport",
      "@hashtree/mesh": "link:../hashtree/ts/packages/hashtree-mesh",
      "@hashtree/collection": "link:../hashtree/ts/packages/hashtree-collection",
      "@hashtree/dexie": "link:../hashtree/ts/packages/hashtree-dexie",
      "@hashtree/git": "link:../hashtree/ts/packages/hashtree-git",
      "@hashtree/index": "link:../hashtree/ts/packages/hashtree-index",
      "@hashtree/merge": "link:../hashtree/ts/packages/hashtree-merge",
      "@hashtree/nostr": "link:../hashtree/ts/packages/hashtree-nostr",
      "@hashtree/worker": "link:../hashtree/ts/packages/hashtree-worker",
      "nostr-social-graph": "link:../nostr-social-graph/ts"
    }
  }
}
