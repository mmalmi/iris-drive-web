  },
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "smoke:drive:iris": "node ./scripts/smoke-files-iris-portable.mjs",
    "smoke:files:iris": "node ./scripts/smoke-files-iris-portable.mjs",
    "test:drive:iris": "pnpm run build && pnpm run smoke:drive:iris",
    "test:files:iris": "pnpm run build && pnpm run smoke:files:iris",
    "publish:drive:iris": "node ./scripts/release-site.mjs drive --skip-cloudflare",
    "release:iris": "node ./scripts/release-site.mjs",
    "release:drive:iris": "node ./scripts/release-site.mjs drive",
    "release:files-redirect": "node ./scripts/deploy-files-redirect.mjs",
    "release:all:iris": "node ./scripts/release-site.mjs all",
    "build:analyze": "vite build && echo '\nBundle stats: dist/stats.html\nBundle list: dist/stats-list.txt'",
    "preview": "vite preview",
    "test": "pnpm run test:unit",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:release": "pnpm run test:e2e:release:local && pnpm run test:e2e:fips",
    "test:e2e:release:local": "PW_WORKERS=${PW_WORKERS:-4} playwright test e2e/account-session.spec.ts e2e/viewer-actions.spec.ts e2e/profile-file-sharing.spec.ts e2e/file-sharing-journey.spec.ts e2e/fips-provider-bridge.spec.ts e2e/contact-follow.spec.ts --project=chromium",
    "test:e2e:fips": "PW_WORKERS=1 playwright test e2e/fips-discovery.spec.ts --project=chromium --retries=1",
    "test:e2e:device-link": "PW_WORKERS=${PW_WORKERS:-2} playwright test e2e/user-settings-link-device.spec.ts e2e/web-native-device-link.spec.ts --project=chromium",
    "test:e2e:shared-folders": "PW_WORKERS=1 playwright test e2e/shared-folder-journey.spec.ts e2e/shared-folder-reconnect.spec.ts --project=chromium",
    "test:e2e:drive-interop": "playwright test e2e/drive-interop.spec.ts",
    "test:e2e:drive-vm-interop": "PW_WORKERS=${PW_WORKERS:-1} playwright test e2e/drive-vm-interop.spec.ts --project=chromium",
    "test:e2e:docker": "bash ./scripts/test-e2e-docker.sh",
    "test:e2e:fast": "E2E_FAST=1 playwright test",
    "test:e2e:integration": "playwright test e2e/anchor-links.spec.ts e2e/compression.spec.ts e2e/explorer.test.ts e2e/link-visible-tree.spec.ts e2e/search-navigation.spec.ts e2e/viewer-actions.spec.ts",
    "test:e2e:slow": "playwright test e2e/livestream-viewer.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
